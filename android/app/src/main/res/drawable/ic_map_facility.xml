<!--
  The parking plate, for the layers menu.

  A rounded square holding a P — the signage shape, not a teardrop. Teardrops in
  this app mean "a point someone chose" (your car, you); a published facility is
  neither, so it takes the plate the street itself uses.

  Drawn as an outline rather than a filled plate so it sits in the same weight
  band as the other menu icons, which are all strokes. The marker on the map is
  the filled version — see MapCanvas.facilityMarker.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The plate. 3dp corners at 24dp matches HandoffShapes.Control's ratio. -->
    <path
        android:pathData="M5,3.25 L19,3.25 A1.75,1.75 0 0 1 20.75,5 L20.75,19 A1.75,1.75 0 0 1 19,20.75 L5,20.75 A1.75,1.75 0 0 1 3.25,19 L3.25,5 A1.75,1.75 0 0 1 5,3.25 Z"
        android:strokeWidth="1.6"
        android:strokeColor="@android:color/white"
        android:fillColor="@android:color/transparent"
        android:strokeLineJoin="round" />

    <!-- The P: a stem and a bowl, stroked so it reads at 24dp. -->
    <path
        android:pathData="M9.6,17 L9.6,7 L12.9,7 A2.9,2.9 0 0 1 12.9,12.8 L9.6,12.8"
        android:strokeWidth="1.7"
        android:strokeColor="@android:color/white"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
